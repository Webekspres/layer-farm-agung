# Copy to .env and adjust secrets for local development:
#   cp .env.example .env

# =============================================================================
# PostgreSQL — lokal native (tanpa Docker), port default 5432
# Gunakan 127.0.0.1 (bukan localhost) agar tidak kena routing IPv6 ke instance lain.
# =============================================================================
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/layerfarm_agung_db?schema=public"

# Setup sekali (psql sebagai superuser postgres, tanpa password jika trust lokal):
#   CREATE DATABASE layerfarm_agung_db;
# Lalu dari repo:
#   bun run db:migrate:deploy
#   bun run db:seed

# Kalau Postgres lokal masih minta password, isi:
# DATABASE_URL="postgresql://postgres:PASSWORD_KAMU@127.0.0.1:5432/layerfarm_agung_db?schema=public"

# Legacy Docker Postgres (jika masih dipakai): host port 5433 — lihat docker-compose.yml
# DATABASE_URL="postgresql://layerfarm_user:secretpassword@127.0.0.1:5433/layerfarm_agung_db?schema=public"

# Staging/production (Neon) — pakai pooled URL di Vercel:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional direct/unpooled untuk migrate dari laptop:
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
# Use LAN IP when testing mobile on a physical device (must match EXPO_PUBLIC_API_URL).
# On Vercel staging: set both to https://your-app.vercel.app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# Opsional — origin tambahan untuk Better Auth (Expo scheme sudah di-hardcode: aapmmobile://)
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:8081"

# Expo / mobile — comma-separated origins for CORS on /api/v1/* (required in production/staging)
# MOBILE_CORS_ORIGINS="http://localhost:8081,http://192.168.1.10:8081"

# =============================================================================
# Object storage — Cloudflare R2 (disarankan lokal & staging; tanpa MinIO/Docker)
# Salin nilai dari .env.production / Vercel. Bucket harus sudah ada di dashboard R2.
# =============================================================================
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="<r2_access_key_id>"
STORAGE_SECRET_KEY="<r2_secret_access_key>"
STORAGE_BUCKET="aapm"
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="false"

# Legacy MinIO lokal (hanya jika `bun run docker:services`):
# STORAGE_ENDPOINT="http://127.0.0.1:9000"
# STORAGE_ACCESS_KEY="aapm_access_key"
# STORAGE_SECRET_KEY="aapm_secret_key_123"
# STORAGE_BUCKET="aapm-storage"
