# Copy to .env and adjust secrets for local development:
#   cp .env.example .env

# =============================================================================
# PostgreSQL — lokal native (tanpa Docker), port default 5432
# Gunakan 127.0.0.1 (bukan localhost) agar tidak kena routing IPv6 ke instance lain.
# =============================================================================
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/layerfarm_agung_db?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
# =============================================================================
# Object storage — Cloudflare R2
# =============================================================================
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="<r2_access_key_id>"
STORAGE_SECRET_KEY="<r2_secret_access_key>"
STORAGE_BUCKET="aapm"
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="false"